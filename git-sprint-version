#!/bin/sh
# git-sprint version command

initialize() {
    :
}

usage() {
    OPTIONS_SPEC="\
git sprint version

Shows version information.

For more specific help type the command followed by --help
--
"
    flags_help
}

cmd_default() {
    # Use the helper script to compute current version
    if [ -x "$(dirname "$0")/scripts/get_version.sh" ]; then
        "$(dirname "$0")/scripts/get_version.sh"
    elif [ -x "./scripts/get_version.sh" ]; then
        ./scripts/get_version.sh
    else
        # Fallback: try git directly
        git describe --tags --abbrev=0 2>/dev/null || echo "0.0.0"
    fi
}

cmd_help() {
    usage
    exit 0
}